#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, m, i;
    int *ptr, *temp;

    printf("Enter initial array size: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid size");
        return 0;
    }

    ptr = (int *)malloc(n * sizeof(int));

    if (ptr == NULL) {
        printf("Memory allocation failed");
        return 1;
    }

    printf("Enter initial elements: ");
    for (i = 0; i < n; i++) {
        scanf("%d", &ptr[i]);
    }

    printf("Enter number of new elements: ");
    scanf("%d", &m);

    if (m < 0) {
        printf("Invalid size");
        free(ptr);
        return 0;
    }

    if (m > 0) {
        temp = (int *)realloc(ptr, (n + m) * sizeof(int));

        if (temp == NULL) {
            printf("Memory reallocation failed");
            free(ptr);
            return 1;
        }

        ptr = temp;

        printf("Enter new elements: ");
        for (i = n; i < n + m; i++) {
            scanf("%d", &ptr[i]);
        }
    }

    printf("Array elements: ");
    for (i = 0; i < n + m; i++) {
        printf("%d ", ptr[i]);
    }

    free(ptr);
    return 0;
}
