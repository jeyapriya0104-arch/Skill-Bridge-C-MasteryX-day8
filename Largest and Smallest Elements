#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i, max, min;
    int *ptr;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Invalid size");
        return 0;
    }

    ptr = (int *)calloc(n, sizeof(int));

    if (ptr == NULL) {
        printf("Memory allocation failed");
        return 1;
    }

    printf("Enter elements: ");
    for (i = 0; i < n; i++) {
        scanf("%d", &ptr[i]);
    }

    max = min = ptr[0];

    for (i = 1; i < n; i++) {
        if (ptr[i] > max)
            max = ptr[i];

        if (ptr[i] < min)
            min = ptr[i];
    }

    printf("Largest element = %d\n", max);
    printf("Smallest element = %d\n", min);

    free(ptr);
    return 0;
}
